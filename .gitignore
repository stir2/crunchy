# Godot 4+ specific ignores
.godot/
/android/
*.tmp
/builds/
/export/
.DS_Store
Thumbs.db

# Local save files (the game normally stores these outside the project).
/save.json
/menu_save_test.json

# Required dialogue dependency; keep machine-local editor addons out of commits.
!/addons/
/addons/*
!/addons/dialogic/

# Keep local Markdown documentation out of the shared repository.
*.[mM][dD]
